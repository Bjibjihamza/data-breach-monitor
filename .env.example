APP_ENV=development
ELASTICSEARCH_URL=http://elasticsearch:9200
REDIS_URL=redis://redis:6379/0

# GitHub public search API. Required for GitHub collection.
GITHUB_TOKEN=
GITHUB_MAX_RESULTS_PER_QUERY=30
GITHUB_MAX_QUERIES_PER_RUN=20
GITHUB_MAX_FILE_FETCHES_PER_RUN=50
GITHUB_MAX_PAGES_PER_QUERY=2
GITHUB_SCAN_MODE=incremental
GITHUB_INTERVAL_MINUTES=60

# Google Alerts RSS. Configure feeds in config/google_alerts_feeds.yml.
GOOGLE_ALERTS_MAX_ENTRIES_PER_FEED=25
GOOGLE_ALERTS_MAX_FEEDS_PER_RUN=20
GOOGLE_ALERTS_INTERVAL_MINUTES=30

# Telegram public-channel collection.
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=data_breach_monitor
TELEGRAM_LIMIT_PER_CHANNEL=20
TELEGRAM_INTERVAL_MINUTES=30

# Alert notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Optional organization-specific watchlists are disabled for the global-first MVP.
ORGANIZATION_WATCHLISTS_ENABLED=false

# Startup/backfill controls.
INITIAL_BACKFILL_ENABLED=true
INITIAL_BACKFILL_RUN_ON_STARTUP=true
INITIAL_BACKFILL_MAX_ITEMS_PER_SOURCE=500
COLLECTION_INTERVAL_MINUTES=30
